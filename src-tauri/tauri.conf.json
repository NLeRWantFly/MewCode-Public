  "productName": "MewCode",
  "version": "0.1.8",
  "identifier": "com.mewcode.desktop",
  "build": {
    "devUrl": "http://127.0.0.1:8765",
    "frontendDist": "../frontend/static"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
