# ===== 核心保留（以下内容会被提交）=====
# mewcode/        核心源码
# docs/           文档
# pyproject.toml  项目与依赖定义
# uv.lock         依赖锁定
# README.md / MEWCODE.md / CLAUDE.md / spec.md / tasks.md / checklist.md

# ===== 测试与验证 =====
# tests/ 必须入库——忽略测试目录等于宣布仓库永远零测试覆盖
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/

# ===== Python 缓存与编译产物 =====
__pycache__/
*.py[cod]
*$py.class
*.so

# ===== 打包与构建 =====
dist/
build/
node_modules/
out/
out-*/
.tmp/
*.egg-info/
*.egg
.eggs/
wheels/

# ===== 虚拟环境 =====
.venv/
venv/
env/
ENV/

# ===== 运行时配置与本地状态（含密钥，切勿提交）=====
.mewcode/
.claude/
.codex/
config.yaml
config.local.yaml
.env
.env.*
*.log

# Local extension packages are source and may be committed; runtime state stays ignored.
/.mewcode/
/.mewcode/*
!/.mewcode/plugins/
!/.mewcode/plugins/**

# Agent worktrees and test scratch data are local-only.
.worktrees/
.pytest-tmp/

